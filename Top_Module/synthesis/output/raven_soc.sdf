  (CELLTYPE "SAEDRVT14_CKGTPLT_V5_1")
  (INSTANCE simpleuart/self_gate_send_pattern_reg_0)
  (DELAY
    (ABSOLUTE
    (COND EN===1'b0 && SE===1'b1 (IOPATH CK Q (0.010:0.010:0.010) (0.009:0.009:0.009)))
    (COND EN===1'b1 && SE===1'b0 (IOPATH CK Q (0.010:0.010:0.010) (0.009:0.009:0.009)))
    (COND EN===1'b1 && SE===1'b1 (IOPATH CK Q (0.010:0.010:0.010) (0.009:0.009:0.009)))
    (IOPATH CK Q (0.010:0.010:0.010) (0.010:0.010:0.010))
    (COND EN===1'b0 && SE===1'b0 (IOPATH (negedge CK) Q () (0.010:0.010:0.010)))
    )
  )
  (TIMINGCHECK
    (WIDTH (negedge CK) (0.029:0.029:0.029))
    (HOLD (posedge EN) (COND ENABLE_NOT_SE === 1'b1 (posedge CK)) (-0.018:-0.016:-0.016))
    (HOLD (negedge EN) (COND ENABLE_NOT_SE === 1'b1 (posedge CK)) (-0.006:-0.006:-0.006))
    (SETUP (posedge EN) (COND ENABLE_NOT_SE === 1'b1 (posedge CK)) (0.023:0.021:0.021))
    (SETUP (negedge EN) (COND ENABLE_NOT_SE === 1'b1 (posedge CK)) (0.011:0.011:0.011))
  )
